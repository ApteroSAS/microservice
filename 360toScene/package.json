{
  "name": "360toscene",
  "version": "1.0.0",
  "description": "Convert 360 images into a Mozilla Hubs Scene with just 1 api call",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src -e js,ts,json --exec \"ts-node src/index.ts\"",
    "build": "tsup src/index.ts --format cjs --clean",
    "start": "node dist/index.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@gltf-transform/core": "^2.4.1",
    "@gltf-transform/extensions": "^2.4.1",
    "cors": "^2.8.5",
    "express": "^4.18.1",
    "omi-gltf-transform": "^0.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/node": "^18.7.6",
    "nodemon": "^2.0.19",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.1.0",
    "tsup": "^6.2.2",
    "typescript": "^4.7.4"
  }
}
